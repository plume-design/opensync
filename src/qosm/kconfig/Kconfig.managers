menuconfig MANAGER_QOSM
    bool "QoS Manager (QoSM)"
    default y
    help
        Enable QoS Manager (QoSM)

if MANAGER_QOSM
    config MANAGER_QOSM_CFG
        string "QoSM Startup configuration"
        default "qosm;true"
        help
            QoS Manager startup configuration
            Optional crash backoff keys (;-separated key=value):
            crash_count_max, crash_count_period, crash_recovery.
            crash_count_max=0 disables. Ignored when needs_plan_b=true.
endif

