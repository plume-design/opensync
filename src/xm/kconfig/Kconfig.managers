menuconfig MANAGER_XM
    bool "Exchange Manager (XM)"
    default n
    help
        Enable Exchange Manager (XM)

    config MANAGER_XM_CFG
        depends on MANAGER_XM
        string "XM Startup configuration"
        default "xm;true"
        help
            Exchange Manager startup configuration
            Optional crash backoff keys (;-separated key=value):
            crash_count_max, crash_count_period, crash_recovery.
            crash_count_max=0 disables. Ignored when needs_plan_b=true.
