menuconfig MANAGER_QM
    bool "Queue Manager (QM)"
    default y
    help
        Enable Queue Manager (QM)

    config MANAGER_QM_CFG
        depends on MANAGER_QM
        string "QM Startup configuration"
        default "qm;true"
        help
            Queue Manager startup configuration
            Optional crash backoff keys (;-separated key=value):
            crash_count_max, crash_count_period, crash_recovery.
            crash_count_max=0 disables. Ignored when needs_plan_b=true.
