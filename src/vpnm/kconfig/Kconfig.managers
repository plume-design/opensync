menuconfig MANAGER_VPNM
    bool "Virtual Private Network Manager (VPNM)"
    default y
    help
        Enable Virtual Private Network Manager (VPNM)

    config MANAGER_VPNM_CFG
        depends on MANAGER_VPNM
        string "VPNM Startup configuration"
        default "vpnm;true"
        help
            Virtual Private Network Manager startup configuration
            Optional crash backoff keys (;-separated key=value):
            crash_count_max, crash_count_period, crash_recovery.
            crash_count_max=0 disables. Ignored when needs_plan_b=true.
