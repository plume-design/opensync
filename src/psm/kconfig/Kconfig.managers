menuconfig MANAGER_PSM
    bool "Persistent Storage Manager (PSM)"
    default y
    help
        Enable Persistent Storage Manager (PSM)

if MANAGER_PSM
    config MANAGER_PSM_CFG
        string "PSM Startup configuration"
        default "psm;true"
        help
            Persistent Storage Manager configuration
            Optional crash backoff keys (;-separated key=value):
            crash_count_max, crash_count_period, crash_recovery.
            crash_count_max=0 disables. Ignored when needs_plan_b=true.
endif
