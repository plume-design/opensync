#!/bin/sh

route_default_add()
{
    ifname="$1"
    gw_addr="$2"
    rt_table="$3"    # optional: routing table for the default route

{% if CONFIG_OSN_LINUX_DEFAULT_ROUTES_VIA_NM %}
    if [ -n "$rt_table" ]; then
        {{CONFIG_TARGET_PATH_TOOLS}}//ovsh U Wifi_Route_Config \
            --where if_name=="$ifname" \
            --where dest_addr=="0.0.0.0" \
            --where dest_mask=="0.0.0.0" \
            --where table=="$rt_table" \
            if_name:="$ifname" \
            dest_addr:="0.0.0.0" \
            dest_mask:="0.0.0.0" \
            gateway:="$gw_addr" \
            table:="$rt_table"
    else
        {{CONFIG_TARGET_PATH_TOOLS}}//ovsh U Wifi_Route_Config \
            --where if_name=="$ifname" \
            --where dest_addr=="0.0.0.0" \
            --where dest_mask=="0.0.0.0" \
            if_name:="$ifname" \
            dest_addr:="0.0.0.0" \
            dest_mask:="0.0.0.0" \
            gateway:="$gw_addr"
    fi
{%- else %}
    if [ -n "$rt_table" ]; then
        ip route replace default via "$gw_addr" dev "$ifname" table "$rt_table"
    else
        # The `ip route` command doesn't allow adding several default routes with
        # the same metric, although they are on different interfaces. This affects
        # the static IPv4 probing of WANO.
        #
        # The `route` command doesn't seem to have this issue.
        route add default gw "$gw_addr" dev "$ifname"
    fi
{%- endif %}
}

route_default_flush()
{
    ifname="$1"
    rt_table="$2"  # optional: when set, default routes are flushed only from that table

{% if CONFIG_OSN_LINUX_DEFAULT_ROUTES_VIA_NM %}
    if [ -n "$rt_table" ]; then
        {{CONFIG_TARGET_PATH_TOOLS}}/ovsh d Wifi_Route_Config \
            --where if_name=="$ifname" \
            --where dest_addr=="0.0.0.0" \
            --where dest_mask=="0.0.0.0" \
            --where table=="$rt_table"
    else
        {{CONFIG_TARGET_PATH_TOOLS}}/ovsh d Wifi_Route_Config \
            --where if_name=="$ifname" \
            --where dest_addr=="0.0.0.0" \
            --where dest_mask=="0.0.0.0"
    fi
{%- else %}
    if [ -n "$rt_table" ]; then
        [ ! -e "/sys/class/net/$ifname" ] || ip route flush 0.0.0.0/0 dev "$ifname" table "$rt_table"
    else
        [ ! -e "/sys/class/net/$1" ] || ip route flush 0.0.0.0/0 dev "$ifname"
    fi
{%- endif %}
}
